WEB_SEARCH_API=
NERVE_BACKEND_URL=

# Comma-separated browser origins allowed to open the Socket.IO connection.
# Unset (or "*") allows any origin, which is fine for the demo.
WEB_ALLOWED_ORIGINS=

# OCI Object Storage. Region and API keys come from ~/.oci/config; only the
# namespace and bucket are required here.
OCI_NAMESPACE=
OCI_BUCKET=
