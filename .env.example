WEB_SEARCH_API=
NERVE_BACKEND_URL=

# Comma-separated browser origins allowed to open the Socket.IO connection.
# Unset (or "*") allows any origin, which is fine for the demo.
WEB_ALLOWED_ORIGINS=

# Model 1 (DeepSeek Flash) is funded by the operator: the backend uses this key
# for any client that selects model 1 and never sends it to clients.
PROVIDED_MODEL_KEY=

# OCI Object Storage (API-key auth, all from env).
OCI_TENANCY=
OCI_USER=
OCI_FINGERPRINT=
OCI_REGION=
# Private key: a mounted PEM path, or inline PEM with \n escapes.
OCI_KEY_FILE=
OCI_KEY_CONTENT=
OCI_PRIVATE_KEY_PASSPHRASE=
OCI_NAMESPACE=
OCI_BUCKET=
